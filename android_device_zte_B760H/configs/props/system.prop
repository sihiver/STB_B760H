# Graphics
ro.opengles.version=131072
debug.hwui.render_dirty_regions=false
debug.hwui.use_partial_updates=false
debug.sf.enable_gl_backpressure=0
debug.sf.latch_unsignaled=1
sys.use_fifo_ui=1
ro.sf.lcd_density=320

# Media
debug.stagefright.ccodec=0
media.stagefright.legacyencoder=true
media.stagefright.less-secure=true
drm.service.enabled=true

# MediaTek Video / Audio optimizations
streamin.sf.vsyncimprove=1
mtk.vdec.onlyone.field=0
mtk.vdec.h264.playfast=1
mtk.omxvdec.enablefast=1
fast.feed=1
ts.fastgetformat=1

# WiFi
wifi.interface=wlan0
wifi.tethering.interface=ap0
wifi.direct.interface=p2p0

# Root
persist.sys.root_access=3

# ZTE Audio & HDMI
ro.product.screenzoom.unit=permillage
ro.config.media_vol_steps=20
box.audio.hdmi.output.setting=decode
box.audio.media.routing_device=AUX_DIGITAL
box.audio.hdmi.pcm_ch.support=2
persist.sys.miniavspdif=MiniAV
zte.stb.net.coexistmode=3

# Device Identity & Fingerprint
ro.product.model=B760H
ro.product.brand=ZTE
ro.product.name=B760H
ro.product.device=B760H
ro.build.product=B760H
ro.build.description=ztemt85_bx_kk-user 4.4.2 KOT49H eng.stb-android.20170607.181315 release-keys
ro.build.fingerprint=Mebox/ztemt85_bx_kk/ztemt85_bx_kk:4.4.2/KOT49H/20170607.181315:user/release-keys
ro.bootimage.build.fingerprint=Mebox/ztemt85_bx_kk/ztemt85_bx_kk:4.4.2/KOT49H/20170607.181315:user/release-keys

# Display Resolution Override
ro.config.size_override=1920,1080

# Dalvik Heap Tuning (1GB RAM)
dalvik.vm.heapstartsize=8m
dalvik.vm.heapgrowthlimit=192m
dalvik.vm.heapsize=384m
dalvik.vm.heaptargetutilization=0.75
dalvik.vm.heapminfree=512k
dalvik.vm.heapmaxfree=8m

# Disable Setup Wizard
ro.setupwizard.mode=DISABLED
ro.setupwizard.wifi_required=false

# Disable ffmpeg omx plugin (causes mediaserver crash on MTK)
#media.sf.omx-plugin=libffmpeg_omx.so
#media.sf.extractor-plugin=libffmpeg_extractor.so