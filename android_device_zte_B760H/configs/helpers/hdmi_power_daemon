#!/system/bin/sh
# HDMI Power Controller Daemon for ZTE B760H (MT8127)
# When screen turns off (standby/sleep), cuts HDMI signal completely
# so the connected TV displays "No Signal" / "Tidak Ada Sinyal".
# When screen turns on (wake up), restores HDMI signal immediately.

# Auto-format internal SD card partition if missing or unformatted
if [ -b /dev/block/mmcblk0p8 ]; then
    if ! blkid /dev/block/mmcblk0p8 2>/dev/null | grep -q "vfat"; then
        /system/bin/newfs_msdos -F 32 -O android /dev/block/mmcblk0p8 >/dev/null 2>&1
        sm mount public:179_8 >/dev/null 2>&1
    fi
fi

# Listen to DisplayManagerService state changes in system buffer
logcat -b system -s DisplayManagerService:I | while read -r line; do
    case "$line" in
        *"Display device changed state:"*", OFF"*)
            /system/bin/ioctl -d /dev/hdmitx 0x4801 0 >/dev/null 2>&1
            /system/bin/ioctl -d /dev/hdmitx 0x4803 0 >/dev/null 2>&1
            /system/bin/ioctl -d /dev/hdmitx 0x4004480c 0 >/dev/null 2>&1
            /system/bin/ioctl -d /dev/hdmitx 0xc004480b 0 >/dev/null 2>&1
            echo off > /proc/ledlight/powergreen/state 2>/dev/null
            echo on > /proc/ledlight/powerred/state 2>/dev/null
            ;;
        *"Display device changed state:"*", ON"*)
            res=$(getprop vendor.hdmi.boot_res)
            [ -z "$res" ] && res=11
            /system/bin/ioctl -d /dev/hdmitx 0xc004480b 1 >/dev/null 2>&1
            /system/bin/ioctl -d /dev/hdmitx 0x4004480c 1 >/dev/null 2>&1
            /system/bin/ioctl -d /dev/hdmitx 0x4801 1 >/dev/null 2>&1
            /system/bin/ioctl -d /dev/hdmitx 0x4803 1 >/dev/null 2>&1
            sleep 1
            /system/bin/ioctl -d /dev/hdmitx 0xc0044806 "$res" >/dev/null 2>&1
            echo 0 > /sys/class/graphics/fb0/blank 2>/dev/null
            echo off > /proc/ledlight/powerred/state 2>/dev/null
            echo on > /proc/ledlight/powergreen/state 2>/dev/null
            ;;
    esac
done
