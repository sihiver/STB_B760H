on property:sys.boot_completed=1
    exec - root -- /system/bin/sh -c "settings put secure show_ime_with_hard_keyboard 1"
    exec - root -- /system/bin/sh -c "settings put secure enabled_input_methods org.liskovsoft.androidtv.rukeyboard/com.liskovsoft.leankeyboard.ime.LeanbackImeService:com.google.android.leanback.ime/.LeanbackImeService"
    exec - root -- /system/bin/sh -c "settings put secure default_input_method org.liskovsoft.androidtv.rukeyboard/com.liskovsoft.leankeyboard.ime.LeanbackImeService"
    exec - root -- /system/bin/sh -c "ime enable org.liskovsoft.androidtv.rukeyboard/com.liskovsoft.leankeyboard.ime.LeanbackImeService"
    exec - root -- /system/bin/sh -c "ime enable com.google.android.leanback.ime/.LeanbackImeService"
    exec - root -- /system/bin/sh -c "ime set org.liskovsoft.androidtv.rukeyboard/com.liskovsoft.leankeyboard.ime.LeanbackImeService"
