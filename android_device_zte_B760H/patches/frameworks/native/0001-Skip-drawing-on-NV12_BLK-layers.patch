From 967b613f041b409efee60680f582872a8a6125c5 Mon Sep 17 00:00:00 2001
From: Dindin Suryadi <din2.suryadi@gmail.com>
Date: Tue, 17 Nov 2026 20:59:06 +0700
Subject: [PATCH 1/3] Skip drawing on NV12_BLK layers

---
 services/surfaceflinger/Android.mk |  4 ++++
 services/surfaceflinger/Layer.cpp  | 14 ++++++++++++++
 2 files changed, 18 insertions(+)

diff --git a/services/surfaceflinger/Android.mk b/services/surfaceflinger/Android.mk
index ffda035..17560ee 100644
--- a/services/surfaceflinger/Android.mk
+++ b/services/surfaceflinger/Android.mk
@@ -142,6 +142,10 @@ LOCAL_SHARED_LIBRARIES := \
     libpowermanager \
     libvulkan
 
+ifeq ($(strip $(BOARD_USES_MTK_HARDWARE)),true)
+LOCAL_CFLAGS += -DMTK_HARDWARE
+endif
+
 LOCAL_MODULE := libsurfaceflinger
 
 LOCAL_CFLAGS += -Wall -Werror -Wunused -Wunreachable-code
diff --git a/services/surfaceflinger/Layer.cpp b/services/surfaceflinger/Layer.cpp
index 3ffa655..5081b35 100644
--- a/services/surfaceflinger/Layer.cpp
+++ b/services/surfaceflinger/Layer.cpp
@@ -55,6 +55,10 @@
 
 #define DEBUG_RESIZE    0
 
+#ifdef MTK_HARDWARE
+#define HAL_PIXEL_FORMAT_NV12_BLK 0x101
+#endif
+
 namespace android {
 
 // ---------------------------------------------------------------------------
@@ -926,6 +930,16 @@ void Layer::onDraw(const sp<const DisplayDevice>& hw, const Region& clip,
         return;
     }
 
+#ifdef MTK_HARDWARE
+    if (mActiveBuffer != 0) {
+        int fmt = mActiveBuffer->getPixelFormat();
+        if ((fmt >= 0x100 && fmt <= 0x103) || fmt == (int)0x7f000001) {
+            // Block-format video can't be imported by the GPU. Draw nothing.
+            return;
+        }
+    }
+#endif
+
     // Bind the current buffer to the GL texture, and wait for it to be
     // ready for us to draw into.
     status_t err = mSurfaceFlingerConsumer->bindTextureImage();
-- 
