diff --git a/Settings/src/com/mediatek/hdmi/HDMINative.java b/Settings/src/com/mediatek/hdmi/HDMINative.java
new file mode 100644
index 0000000..bf9a9d6
--- /dev/null
+++ b/Settings/src/com/mediatek/hdmi/HDMINative.java
@@ -0,0 +1,48 @@
+package com.mediatek.hdmi;
+
+public class HDMINative {
+    static {
+        System.loadLibrary("mtkhdmi_jni");
+    }
+
+    public native boolean enableHdmiNative(boolean enable);
+    public native boolean enableHdmiIpoNative(boolean enable);
+    public native boolean enableVideoNative(boolean enable);
+    public native boolean enableAudioNative(boolean enable);
+    public native boolean enableCecNative(boolean enable);
+    public native boolean enableHdcpNative(boolean enable);
+    public native boolean setVideoConfigNative(int newValue);
+    public native boolean setAudioConfigNative(int newValue);
+    public native boolean setDeepColorNative(int colorSpace, int deepColor);
+    public native boolean setHdcpKeyNative(byte[] key);
+    public native boolean setHdmiDrmKeyNative();
+    public native boolean setCecAddrNative(byte laNum, byte[] la, int pa, char svc);
+    public native boolean setCecCmdNative(byte initAddr, byte destAddr, short opcode, byte[] operand, int size, byte enqueueOk);
+    public native int[] getEdidNative();
+    public native int[] getCecAddrNative();
+    public native int[] getCecCmdNative();
+    public native boolean hdmiPowerEnableNative(boolean enable);
+    public native boolean hdmiPortraitEnableNative(boolean enable);
+    public native boolean isHdmiForceAwakeNative();
+    public native int getDisplayTypeNative();
+    public native boolean needSwDrmProtectNative();
+    public native boolean notifyOtgStateNative(int state);
+    public native int getCapabilitiesNative();
+    public native int[] getCecTxSTsNative();
+    public native boolean resetHdmiFlashNative(int newValue);
+    public native boolean set3DVideoNative(int mode);
+    public native int getHdcpStatusNative();
+    public native boolean setUserMuteAudioNative(int mute);
+
+    public boolean setVideoConfig(int newValue) {
+        return setVideoConfigNative(newValue);
+    }
+
+    public boolean hdmiPowerEnable(boolean enable) {
+        return hdmiPowerEnableNative(enable);
+    }
+
+    public int[] getEDID() {
+        return getEdidNative();
+    }
+}
