+    private static int pickAutoRes(int[] edid) {
+        if (edid != null && edid.length >= 2) {
+            int ntsc = edid[0];
+            int pal = edid[1];
+            if ((ntsc & 8) != 0) return 11;
+            if ((pal & 2048) != 0) return 12;
+            if ((ntsc & 2) != 0) return 2;
+            if ((pal & 512) != 0) return 3;
+        }
+        return 11;
+    }
