From 20385ca4c214286e3b1672829e608cf89512a83c Mon Sep 17 00:00:00 2001
From: gamblingaddict <112048350+gamblingaddict@users.noreply.github.com>
Date: Mon, 5 Oct 2026 12:50:09 +0700
Subject: [PATCH] Add app restart prompt for storage permission

For devices with ancient kernels that require an app restart for
storage access to work.

Change-Id: Ia692d9409f5b90b66eb9401a6c8062fa8615b833
---
 AndroidManifest.xml                           |  1 +
 res/values/config.xml                         |  4 ++
 res/values/strings.xml                        |  2 +
 .../ui/GrantPermissionsActivity.java          | 61 +++++++++++++++++++
 4 files changed, 68 insertions(+)
 create mode 100644 res/values/config.xml

diff --git a/AndroidManifest.xml b/AndroidManifest.xml
index eaa279b..1dca29f 100644
--- a/AndroidManifest.xml
+++ b/AndroidManifest.xml
@@ -21,6 +21,7 @@
     <uses-permission android:name="android.permission.MANAGE_APP_OPS_RESTRICTIONS" />
     <uses-permission android:name="android.permission.INTERNET" />
     <uses-permission android:name="android.permission.HIDE_NON_SYSTEM_OVERLAY_WINDOWS" />
+    <uses-permission android:name="android.permission.FORCE_STOP_PACKAGES" />
 
     <uses-permission android:name="com.google.android.permission.INSTALL_WEARABLE_PACKAGES" />
 
diff --git a/res/values/config.xml b/res/values/config.xml
new file mode 100644
index 0000000..ba32543
--- /dev/null
+++ b/res/values/config.xml
@@ -0,0 +1,4 @@
+<?xml version="1.0" encoding="utf-8"?>
+<resources>
+    <bool name="config_storageGrantNeedsRestart">false</bool>
+</resources>
\ No newline at end of file
diff --git a/res/values/strings.xml b/res/values/strings.xml
index 12ad5f1..b104e25 100644
--- a/res/values/strings.xml
+++ b/res/values/strings.xml
@@ -308,4 +308,6 @@
     <!-- Help URL, application permissions [DO NOT TRANSLATE] -->
     <string name="help_app_permissions" translatable="false"></string>
 
+    <string name="storage_restart_message">Allow <b>%1$s</b> to restart so it can use storage?</string>
+
 </resources>
diff --git a/src/com/android/packageinstaller/permission/ui/GrantPermissionsActivity.java b/src/com/android/packageinstaller/permission/ui/GrantPermissionsActivity.java
index b134729..775f08e 100644
--- a/src/com/android/packageinstaller/permission/ui/GrantPermissionsActivity.java
+++ b/src/com/android/packageinstaller/permission/ui/GrantPermissionsActivity.java
@@ -19,6 +19,8 @@ package com.android.packageinstaller.permission.ui;
 import static android.content.pm.PackageManager.PERMISSION_DENIED;
 import static android.content.pm.PackageManager.PERMISSION_GRANTED;
 
+import android.Manifest;
+import android.app.ActivityManager;
 import android.app.admin.DevicePolicyManager;
 import android.content.Intent;
 import android.content.pm.PackageInfo;
@@ -68,6 +70,12 @@ public class GrantPermissionsActivity extends OverlayTouchActivity
 
     boolean mResultSet;
 
+    private static final String RESTART_GROUP = "com.android.packageinstaller.RESTART_PROMPT";
+
+    private boolean mStorageGranted;
+    private boolean mRestartAsked;
+    private AppPermissionGroup mStorageGroup;
+
     @Override
     public void onCreate(Bundle icicle) {
         super.onCreate(icicle);
@@ -265,11 +273,24 @@ public class GrantPermissionsActivity extends OverlayTouchActivity
 
     @Override
     public void onPermissionGrantResult(String name, boolean granted, boolean doNotAskAgain) {
+        if (RESTART_GROUP.equals(name)) {
+            if (granted) {
+                restartApp(mAppPermissions.getPackageInfo().packageName);
+            } else {
+                setResultAndFinish();
+            }
+            return;
+        }
+
         GroupState groupState = mRequestGrantPermissionGroups.get(name);
         if (groupState.mGroup != null) {
             if (granted) {
                 groupState.mGroup.grantRuntimePermissions(doNotAskAgain);
                 groupState.mState = GroupState.STATE_ALLOWED;
+                if (Manifest.permission_group.STORAGE.equals(groupState.mGroup.getName())) {
+                    mStorageGranted = true;
+                    mStorageGroup = groupState.mGroup;
+                }
             } else {
                 groupState.mGroup.revokeRuntimePermissions(doNotAskAgain);
                 groupState.mState = GroupState.STATE_DENIED;
@@ -277,10 +298,50 @@ public class GrantPermissionsActivity extends OverlayTouchActivity
             updateGrantResults(groupState.mGroup);
         }
         if (!showNextPermissionGroupGrantRequest()) {
+            finishOrAskRestart();
+        }
+    }
+
+    private void finishOrAskRestart() {
+        if (mStorageGranted && !mRestartAsked
+                && getResources().getBoolean(R.bool.config_storageGrantNeedsRestart)) {
+            mRestartAsked = true;
+            showRestartPrompt();
+        } else {
             setResultAndFinish();
         }
     }
 
+    private void showRestartPrompt() {
+        Spanned message = Html.fromHtml(getString(R.string.storage_restart_message,
+                mAppPermissions.getAppLabel()), 0);
+        setTitle(message);
+
+        // Reuse the storage group's icon so it looks like the prompt just shown
+        Resources resources;
+        try {
+            resources = getPackageManager().getResourcesForApplication(
+                    mStorageGroup.getIconPkg());
+        } catch (NameNotFoundException e) {
+            resources = Resources.getSystem();
+        }
+
+        // groupCount = 1 so no "1 of N" breadcrumb is shown
+        mViewHandler.updateUi(RESTART_GROUP, 1, 0,
+                Icon.createWithResource(resources, mStorageGroup.getIconResId()),
+                message, false /* showDoNotAsk */);
+    }
+
+    private void restartApp(String pkg) {
+        final Intent launch = getPackageManager().getLaunchIntentForPackage(pkg);
+        getSystemService(ActivityManager.class).forceStopPackage(pkg);
+        if (launch != null) {
+            launch.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK | Intent.FLAG_ACTIVITY_CLEAR_TASK);
+            startActivity(launch);
+        }
+        finish();
+    }
+
     private void updateGrantResults(AppPermissionGroup group) {
         for (Permission permission : group.getPermissions()) {
             final int index = ArrayUtils.getArrayIndex(
-- 
